Button #Button {
  LayoutMode: Left;
  Padding: (Full: 6);
  Style: (
    Hovered: (
      Background: #000000(0.2),
    )
  );

  ItemIcon #Icon {
    Anchor: (Width: 32, Height: 32);
  }

  Label #Name {
    Padding: (Horizontal: 10, Vertical: 5);
    Style: (RenderBold: true);
    FlexWeight: 1;
  }

  Label #On {
    Padding: (Horizontal: 10, Vertical: 5);
    Visible: false;
    Text: %server.customUI.arrakisPicker.on;
    Style: (RenderBold: true, TextColor: #5cd65c);
  }

  Label #Off {
    Padding: (Horizontal: 10, Vertical: 5);
    Text: %server.customUI.arrakisPicker.off;
    Style: (TextColor: #ffffff(0.45));
  }

  Group {
    LayoutMode: Full;
    Anchor: (Height: 2);
    Background: #ffffff(0.6);
  }
}
