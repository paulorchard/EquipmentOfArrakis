$C = "../../../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 560);

    #Title {
      $C.@Title {
        @Text = %server.customUI.arrakisPicker.title;
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 16);

      Label {
        Anchor: (Bottom: 6);
        Text: %server.customUI.arrakisPicker.toolsHeading;
        Style: (...$C.@DefaultLabelStyle, RenderBold: true, FontSize: 16, TextColor: #ffcc00);
      }

      Group #ToolList {
        LayoutMode: Top;
      }

      Label #Only {
        Anchor: (Top: 4, Bottom: 4);
        Visible: false;
        Style: (...$C.@DefaultLabelStyle, FontSize: 14, TextColor: #ffffff(0.6));
      }

      Label {
        Anchor: (Top: 14, Bottom: 6);
        Text: %server.customUI.arrakisPicker.passiveHeading;
        Style: (...$C.@DefaultLabelStyle, RenderBold: true, FontSize: 16, TextColor: #ffcc00);
      }

      Group #PassiveList {
        LayoutMode: Top;
      }
    }
  }
}

$C.@BackButton {}
