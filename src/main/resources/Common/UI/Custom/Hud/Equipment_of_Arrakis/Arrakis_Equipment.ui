// Equipment of Arrakis HUD: POWER to the left of the hotbar, AMMO to the right of it, and the tool panel above POWER.
//
// Layout. There is no percentage unit in .ui, so the screen is split in two halves of equal FlexWeight: the middle of the screen (the
// middle of the hotbar, which the client draws centred) is then exact at every resolution and aspect ratio. In the left half, a flexible
// spacer pushes the POWER readout to the right edge of the half, and a fixed pad (PowerOffset) keeps its right end that far from the
// middle; the right half mirrors it for AMMO (pad = AmmoOffset, readout to the left edge). The tool panel is another such row above the
// readouts. The numbers below are only starting points: EquipmentHud sets every anchor again from Equipment_of_Arrakis.json when the
// document is built. The labels and numbers (#PowerLabel, #PowerNumber, #AmmoLabel, #AmmoNumber, #ToolName) are added by the code from the
// same settings, because their font size, outline and colour are settings too.

Group #EquipRow {
  Anchor: (Left: 0, Right: 0, Bottom: 24, Height: 90);
  LayoutMode: Left;

  Group #EquipLeftHalf {
    FlexWeight: 1;
    LayoutMode: Left;

    Group #EquipLeftSpacer {
      FlexWeight: 1;
    }

    Group #PowerReadout {
      Anchor: (Width: 220);
      LayoutMode: Top;
    }

    Group #PowerPad {
      Anchor: (Width: 465);
    }
  }

  Group #EquipRightHalf {
    FlexWeight: 1;
    LayoutMode: Left;

    Group #AmmoPad {
      Anchor: (Width: 360);
    }

    Group #AmmoReadout {
      Anchor: (Width: 220);
      LayoutMode: Top;
    }

    Group #EquipRightSpacer {
      FlexWeight: 1;
    }
  }
}

Group #ToolRow {
  Anchor: (Left: 0, Right: 0, Bottom: 122, Height: 48);
  LayoutMode: Left;
  Visible: false;

  Group #ToolLeftHalf {
    FlexWeight: 1;
    LayoutMode: Left;

    Group #ToolLeftSpacer {
      FlexWeight: 1;
    }

    Group #ToolPanel {
      Anchor: (Width: 260);
      LayoutMode: Left;

      ItemIcon #ToolIcon {
        Anchor: (Width: 40, Height: 40);
      }

      Group #ToolNameHolder {
        FlexWeight: 1;
        LayoutMode: Top;
      }
    }

    Group #ToolPad {
      Anchor: (Width: 465);
    }
  }

  Group #ToolRightHalf {
    FlexWeight: 1;
  }
}
