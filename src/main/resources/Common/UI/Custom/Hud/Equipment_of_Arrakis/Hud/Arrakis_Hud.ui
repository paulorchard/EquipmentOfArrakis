// The four-bar HUD of Equipment of Arrakis, generated by tools/assets/hud/make_hud.js (the numbers are only defaults: HudView sets them again
// from the Hud section of Equipment_of_Arrakis.json). Two rows above the hotbar, each split in half at the middle of the screen, which is the
// middle of the hotbar. Power over Health on the left, Heat Exposure over Water on the right. A bar is a track of two parts that share its
// length by FlexWeight (1000 - v and v), so the fill is exactly v of the bar at any screen size; left bars fill from their outer (left) end,
// right bars from their outer (right) end. Fill colour is Background.Color on a white texture; the sheen is not tinted.

Group #PowerRow {
  Anchor: (Left: 0, Right: 0, Bottom: 137, Height: 12);
  LayoutMode: Left;

  Group #PowerHalf {
    FlexWeight: 1;
    LayoutMode: Left;

    Group #PowerSpacer {
      FlexWeight: 1;
    }

    Group #PowerTrack {
      Anchor: (Width: 307);
      LayoutMode: Left;
      Background: (TexturePath: "Arrakis_Hud_Bar_Background_Left.png", HorizontalBorder: 12);

      Group #PowerFill {
        FlexWeight: 0;
        Background: (TexturePath: "Arrakis_Hud_Bar_Fill_Left.png", HorizontalBorder: 12, Color: #57bbaf);

        Group #PowerSheen {
          Background: (TexturePath: "Arrakis_Hud_Bar_Sheen_Left.png", HorizontalBorder: 12);
        }
      }

      Group #PowerEmpty {
        FlexWeight: 1000;
      }
    }

    Group #PowerPad {
      Anchor: (Width: 7);
    }
  }

  Group #PowerOtherHalf {
    FlexWeight: 1;
  }
}

Group #PowerIconRow {
  Anchor: (Left: 0, Right: 0, Bottom: 132, Height: 22);
  LayoutMode: Left;

  Group #PowerIconHalf {
    FlexWeight: 1;
    LayoutMode: Left;

    Group #PowerIconSpacer {
      FlexWeight: 1;
    }

    Group #PowerIcon {
      Anchor: (Width: 22, Height: 22);
      Background: "Arrakis_Hud_Icon_Power.png";
    }

    Group #PowerIconPad {
      Anchor: (Width: 323);
    }
  }

  Group #PowerIconOtherHalf {
    FlexWeight: 1;
  }
}

