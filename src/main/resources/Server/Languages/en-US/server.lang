# ---- cutter
items.Arrakis_Tool_Cutter_Ray.name = Cutter Ray
items.Arrakis_Tool_Cutter_Ray.description = Placeholder gun that cuts the block in front of it with the strength of a crude pickaxe. 10 Mana per shot. Right click opens the tool picker.

# ---- compactor
items.Arrakis_Tool_Compactor.name = Compactor
items.Arrakis_Tool_Compactor.description = Hold left click on sand to compact it: one item per second, the block is not broken. 1 Mana per second. Right click opens the tool picker.

# ---- litrejon
items.Arrakis_Tool_Litrejon.name = LitreJon
items.Arrakis_Tool_Litrejon.description = A water flask. Left click pours up to 50 units into you, only what you lack. The bar shows how full it is. Right click opens the tool picker.
arrakis.litrejon.needsWater = Water of Arrakis is needed to pour from the LitreJon.
arrakis.litrejon.empty = The LitreJon is empty.
arrakis.litrejon.full = You are not thirsty.

# ---- harvester
items.Arrakis_Tool_Dew_Harvester.name = Dew Harvester
items.Arrakis_Tool_Dew_Harvester.description = Hold left click on a Primrose to collect dew: 10 water into a LitreJon you carry per swing, 10 Mana each. Right click opens the tool picker.
arrakis.harvester.noPrimrose = Aim at a Primrose.
arrakis.harvester.noFlask = You carry no LitreJon.
arrakis.harvester.flasksFull = Your LitreJon is full.

# ---- bloodbag
items.Arrakis_Blood_Bag.name = Blood Bag
items.Arrakis_Blood_Bag.description = Holds blood collected with the Blood Extractor. The bar shows how full it is. It does nothing else yet.
commands.arrakis.blood.desc = Blood helpers: add, corpse
commands.arrakis.blood.corpse.desc = Spawns a cow two blocks ahead and kills it, to try the Blood Extractor
commands.arrakis.blood.add.desc = Adds blood to the first Blood Bag with room: arrakis blood add <n>

# ---- extractor
items.Arrakis_Tool_Blood_Extractor.name = Blood Extractor
items.Arrakis_Tool_Blood_Extractor.description = Left click on a fresh mob corpse: you crouch, poke it, and 10 blood goes into a Blood Bag you carry. One use per body. Right click opens the tool picker.
arrakis.extractor.noCorpse = No fresh corpse in reach.
arrakis.extractor.used = That body has already been used.
arrakis.extractor.needCrouch = Crouch first.
arrakis.extractor.noBag = You carry no Blood Bag.
arrakis.extractor.bagsFull = Your Blood Bags are full.

