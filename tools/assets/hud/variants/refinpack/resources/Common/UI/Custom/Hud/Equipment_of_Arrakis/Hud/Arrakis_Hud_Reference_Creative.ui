// The four-bar HUD of Equipment of Arrakis, generated by tools/assets/hud/make_hud.js: route Reference (paths inside the pack), creative art.
// Laid out like the vanilla Health.ui (left bars) and Mana.ui (right bars) with the vanilla ProgressBar: the server sets Value (0..1) and
// Bar.Color; the numbers below are the vanilla ones (see vanilla-metrics.json) and HudView sets them again from the Hud config section.
// Texture paths point at VanillaDerived/ (copies), so this document works on its own.

Group #PowerRow {
  Anchor: (Left: 0, Right: 0, Bottom: 146, Height: 12);
  LayoutMode: Left;

  Group #PowerHalf {
    FlexWeight: 1;
    LayoutMode: Left;

    Group #PowerSpacer {
      FlexWeight: 1;
    }

      Group #PowerBlock {
        Anchor: (Width: 346);
        LayoutMode: Left;

        Group #PowerIcon {
          Anchor: (Left: 0, Width: 24, Height: 24, Right: 4, Top: -8);
          Background: (TexturePath: "VanillaDerived/StaminaIconWhite.png", Color: #7fd0ff);
        }

        Group #PowerBar {
          Anchor: (Left: 0, Width: 318, Height: 12);
          Background: "VanillaDerived/HealthBackground.png";

          Group #PowerError {
            Visible: false;
            Background: PatchStyle(TexturePath: "VanillaDerived/ErrorLeft.png", Color: #ffffff);
          }

          Group #PowerFillTrack {
            LayoutMode: Left;

              Group #PowerFill {
              FlexWeight: 0;
              Background: (TexturePath: "VanillaDerived/NeutralCreativeHealthBarFill.png", HorizontalBorder: 9, Color: #57bbaf);
            }

            Group #PowerEmpty {
              FlexWeight: 1000;
            }
          }

          Group #PowerAlertGroup {
            Visible: false;
            LayoutMode: Left;

            Group #PowerAlert {
              FlexWeight: 0;
              Background: (TexturePath: "VanillaDerived/NeutralCreativeHealthBarFill.png", HorizontalBorder: 9, Color: #e6004f);
            }

            Group #PowerAlertEmpty {
              FlexWeight: 1000;
            }
          }

          ProgressBar #PowerEffect {
            Anchor: (Width: 318, Height: 12);
            BarTexturePath: "VanillaDerived/HealthBarEffect.png";
            Value: 0;
          }

          Group #PowerOutline {
            Visible: false;
            Background: PatchStyle(TexturePath: "VanillaDerived/ErrorOutlineLeft.png", Color: #ffffff);
          }

          Group #PowerOutlineDim {
            Visible: false;
            Background: PatchStyle(TexturePath: "VanillaDerived/ErrorOutlineLeft.png", Color: #ffffff(0.5));
          }
        }
      }

    Group #PowerPad {
      Anchor: (Width: 5);
    }
  }

  Group #PowerOtherHalf {
    FlexWeight: 1;
  }
}

