// The four-bar HUD of Equipment of Arrakis, generated by tools/assets/hud/make_hud.js: route Reference, creative art.
// Laid out like the vanilla Health.ui (left bars) and Mana.ui (right bars) with the vanilla ProgressBar: the server sets Value (0..1) and
// Bar.Color; the numbers below are the vanilla ones (see vanilla-metrics.json) and HudView sets them again from the Hud config section.
// Texture paths point at the vanilla files, so a texture pack that redraws them redraws these bars.

Group #PowerRow {
  Anchor: (Left: 0, Right: 0, Bottom: 146, Height: 12);
  LayoutMode: Left;

  Group #PowerHalf {
    FlexWeight: 1;
    LayoutMode: Left;

    Group #PowerSpacer {
      FlexWeight: 1;
    }

      Group #PowerBlock {
        Anchor: (Width: 346);
        LayoutMode: Left;

        Group #PowerIcon {
          Anchor: (Left: 0, Width: 24, Height: 24, Right: 4, Top: -8);
          Background: (TexturePath: "VanillaDerived/StaminaIconWhite.png", Color: #7fd0ff);
        }

        Group #PowerBar {
          Anchor: (Left: 0, Width: 318, Height: 12);
          Background: "../../../InGame/Hud/Health/HealthBackground.png";

          Group #PowerError {
            Background: PatchStyle(TexturePath: "VanillaDerived/ErrorLeft.png", Color: #ffffff(0));
          }

          ProgressBar #PowerFill {
            Anchor: (Width: 318, Height: 12);
            BarTexturePath: "VanillaDerived/NeutralCreativeHealthBarFill.png";
            Bar: (Color: #57bbaf);
            Value: 0;
          }

          Group #PowerAlertGroup {
            Visible: false;

            ProgressBar #PowerAlert {
              Anchor: (Width: 318, Height: 12);
              BarTexturePath: "VanillaDerived/NeutralCreativeHealthBarFill.png";
              Bar: (Color: #e6004f);
              Value: 0;
            }
          }

          ProgressBar #PowerEffect {
            Anchor: (Width: 318, Height: 12);
            BarTexturePath: "../../../InGame/Hud/Health/HealthBarEffect.png";
            Value: 0;
          }

          Group #PowerOutline {
            Background: PatchStyle(TexturePath: "VanillaDerived/ErrorOutlineLeft.png", Color: #ffffff(0));
          }
        }
      }

    Group #PowerPad {
      Anchor: (Width: 5);
    }
  }

  Group #PowerOtherHalf {
    FlexWeight: 1;
  }
}

